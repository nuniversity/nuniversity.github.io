{
  "name": "check-i18n-parity",
  "version": "1.0.0",
  "description": "Checks dictionary key parity across en/pt/es locale files",
  "type": "hook",
  "event": "file.write",
  "pattern": "dictionaries/*.json",
  "script": "scripts/check_i18n_parity.py",
  "blocking": false,
  "exit_codes": {
    "0": "pass",
    "1": "non-blocking warning"
  },
  "dependencies": [],
  "environment": {
    "OPENCODE_DICT_DIR": "Path to dictionaries directory (default: ../../dictionaries)"
  }
}
