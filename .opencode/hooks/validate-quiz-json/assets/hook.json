{
  "name": "validate-quiz-json",
  "version": "1.0.0",
  "description": "Validates quiz JSON files",
  "type": "hook",
  "event": "file.write",
  "pattern": "content/quizzes/**/*.json",
  "script": "scripts/validate_quiz_json.py",
  "blocking": true,
  "exit_codes": {
    "0": "pass",
    "2": "blocking error"
  },
  "dependencies": [],
  "environment": {
    "OPENCODE_FILE_PATH": "Path to the quiz JSON file being validated"
  }
}
