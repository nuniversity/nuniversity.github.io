{
  "name": "validate-languages",
  "version": "1.0.0",
  "description": "Validates language activity JSON files",
  "type": "hook",
  "event": "file.write",
  "pattern": "content/languages/**/*.json",
  "script": "scripts/validate_languages.py",
  "blocking": true,
  "exit_codes": {
    "0": "pass",
    "2": "blocking error"
  },
  "dependencies": [],
  "environment": {
    "OPENCODE_FILE_PATH": "Path to the language activity JSON file being validated"
  }
}
