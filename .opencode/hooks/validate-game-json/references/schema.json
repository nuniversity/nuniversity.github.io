{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game JSON Schema",
  "type": "object",
  "required": ["id", "title", "description", "difficulty", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique game identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Game title"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Brief description"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Difficulty level"
    },
    "category": {
      "type": "string",
      "enum": ["vocabulary"],
      "description": "Game category"
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/vocabulary" }
  ],
  "$defs": {
    "vocabulary": {
      "type": "object",
      "required": ["language_pair", "words"],
      "properties": {
        "language_pair": {
          "type": "object",
          "required": ["source", "target"]
        },
        "words": {
          "type": "array",
          "minItems": 40,
          "items": {
            "type": "object",
            "required": ["source", "target", "context"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "context": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
