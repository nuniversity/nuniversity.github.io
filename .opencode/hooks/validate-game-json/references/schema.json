{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game JSON Schema",
  "type": "object",
  "required": ["id", "title", "description", "difficulty", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique game identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Game title"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Brief description"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Difficulty level"
    },
    "category": {
      "type": "string",
      "enum": ["coding", "conversation", "logic", "math", "physics", "puzzles"],
      "description": "Game category"
    }
  }
}
