{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course JSON Schema",
  "type": "object",
  "required": ["area", "en"],
  "properties": {
    "area": {
      "type": "string",
      "minLength": 1,
      "description": "Course category/area"
    },
    "author": {
      "type": "string",
      "description": "Course author"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Course difficulty level"
    },
    "duration": {
      "type": "string",
      "description": "Estimated course duration"
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier"
    },
    "en": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"]
        },
        "duration": { "type": "string" }
      }
    },
    "pt": { "$ref": "#/$defs/locale" },
    "es": { "$ref": "#/$defs/locale" }
  },
  "$defs": {
    "locale": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "difficulty": {
          "type": "string",
          "enum": ["Iniciante", "Intermediário", "Avançado", "Beginner", "Intermediate", "Advanced", "Principiante", "Intermedio", "Avanzado"]
        },
        "duration": { "type": "string" }
      }
    }
  }
}
