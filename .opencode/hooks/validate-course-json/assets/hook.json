{
  "name": "validate-course-json",
  "version": "1.0.0",
  "description": "Validates course.json metadata files",
  "type": "hook",
  "event": "file.write",
  "pattern": "content/courses/**/course.json",
  "script": "scripts/validate_course_json.py",
  "blocking": true,
  "exit_codes": {
    "0": "pass",
    "2": "blocking error"
  },
  "dependencies": [],
  "environment": {
    "OPENCODE_FILE_PATH": "Path to the course.json file being validated"
  }
}
