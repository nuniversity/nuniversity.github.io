{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hook Schema",
  "description": "Schema for hook registration in opencode.json",
  "type": "object",
  "required": ["name", "pattern", "script", "blocking"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique hook identifier (kebab-case)"
    },
    "pattern": {
      "type": "string",
      "description": "Glob pattern for files to match"
    },
    "script": {
      "type": "string",
      "description": "Path to Python script"
    },
    "blocking": {
      "type": "boolean",
      "description": "Whether to block operation on failure"
    }
  },
  "additionalProperties": false
}
