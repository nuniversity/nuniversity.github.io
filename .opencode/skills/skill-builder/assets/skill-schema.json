{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Schema",
  "description": "Schema for skill.json files",
  "type": "object",
  "required": ["name", "version", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique skill identifier (kebab-case)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200,
      "description": "Skill description (20-200 characters)"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "hook", "plugin", "tool"],
      "description": "Resource type"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "File patterns that activate this skill"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required packages or dependencies"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Skill category"
        },
        "audience": {
          "type": "string",
          "description": "Target audience"
        },
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"],
          "description": "Difficulty level"
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "documentation": {
          "type": "string",
          "format": "uri",
          "description": "Documentation URL"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Repository URL"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
