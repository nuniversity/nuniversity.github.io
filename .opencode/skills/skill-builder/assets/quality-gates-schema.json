{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Gates Schema",
  "description": "Schema for quality gate configuration",
  "type": "object",
  "required": ["gates"],
  "properties": {
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "checks"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Gate name"
          },
          "type": {
            "type": "string",
            "enum": ["structure", "content", "scripts", "integration", "documentation"],
            "description": "Gate type"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "script"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Check name"
                },
                "script": {
                  "type": "string",
                  "description": "Path to validation script"
                },
                "required": {
                  "type": "boolean",
                  "description": "Whether check is required"
                }
              },
              "additionalProperties": false
            },
            "description": "List of checks"
          }
        },
        "additionalProperties": false
      },
      "description": "List of quality gates"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version"
        },
        "description": {
          "type": "string",
          "description": "Schema description"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
