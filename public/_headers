# Security headers for Cloudflare Pages.
#
# This file is INERT on GitHub Pages (which cannot set response headers) —
# there it is simply served as a text file, and the policy reaches browsers
# through the `<meta http-equiv="Content-Security-Policy">` tag in the layout.
#
# On Cloudflare Pages, this file is parsed at deploy time and applied to every
# static asset response, which unlocks the directives a `meta` tag cannot
# carry: `frame-ancestors`, `report-uri`, and real HTTP semantics.
#
# When migrating:
#   1. Point the Pages project at the `out/` directory.
#   2. Delete the `<meta http-equiv>` CSP from `app/[lang]/layout.tsx`, and the
#      `CSP` constant + `ensureCsp()` step from `scripts/postbuild.mjs`.
#   3. Keep `scripts/verify-csp.mjs` — it validates the meta tag today, and
#      can be extended to validate this file.
#
# Keep the directive list in step with app/[lang]/layout.tsx until then.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://formspree.io https://files.rcsb.org; frame-src https://phet.colorado.edu https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build assets are immutable — cache them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated media and the search index change only on deploy.
/media/*
  Cache-Control: public, max-age=86400

/search-index/*
  Cache-Control: public, max-age=86400

# HTML must revalidate so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
