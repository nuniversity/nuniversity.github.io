{
  "name": "nuniversity-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs && node scripts/verify-css.mjs && node scripts/verify-csp.mjs",
    "start": "node tests/support/static-server.mjs out 3000",
    "lint": "next lint",
    "prebuild": "node scripts/publish-media.mjs && node scripts/generate-search-index.mjs && node scripts/build-question-index.mjs && node scripts/build-vocab-index.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:artifact": "vitest run --config vitest.artifact.config.ts",
    "test:e2e": "bash scripts/with-playwright-libs.sh playwright test",
    "test:e2e:integration": "bash scripts/with-playwright-libs.sh playwright test tests/e2e/integration",
    "test:e2e:journeys": "bash scripts/with-playwright-libs.sh playwright test tests/e2e/journeys",
    "test:all": "npm run build && npm run test:artifact && npm run test:e2e",
    "lint:content": "node scripts/lint-prose.mjs",
    "check:prose": "node scripts/normalise-prose.mjs",
    "fix:prose": "node scripts/normalise-prose.mjs --write",
    "icons": "node scripts/make-favicons.mjs",
    "security:bandit": "node scripts/security-bandit.mjs",
    "report:media": "node scripts/report-media-coverage.mjs",
    "report:coverage": "node scripts/report-content-coverage.mjs",
    "validate:courses": "node scripts/validate-courses.mjs",
    "validate:language": "node scripts/validate-language-course.mjs",
    "backfill:skills": "node scripts/add-lesson-skills.mjs",
    "convert:questions": "node scripts/convert-prose-questions.mjs",
    "export:quizzes": "node scripts/export-quiz-bank.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e:mobile": "bash scripts/with-playwright-libs.sh playwright test --project=mobile-chrome",
    "test:e2e:matrix": "bash scripts/with-playwright-libs.sh playwright test --project=firefox --project=webkit --project=mobile-chrome",
    "verify:full": "npm run test:artifact && npm run test:e2e",
    "test:ci": "npm run typecheck && npm run typecheck:e2e && npm run test:coverage && npm run test:artifact",
    "test:e2e:mobile-smoke": "bash scripts/with-playwright-libs.sh playwright test tests/e2e/integration/mobile-nav.spec.ts --project=mobile-chrome",
    "security:gitleaks": "node scripts/security-gitleaks.mjs",
    "security:lockfile": "node scripts/security-lockfile.mjs",
    "security:scan": "node scripts/security-gitleaks.mjs --full",
    "verify:precommit": "node scripts/verify-precommit.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formspree/react": "^3.0.0",
    "3dmol": "^2.5.5",
    "framer-motion": "^12.23.12",
    "katex": "^0.16.47",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.12.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ts-fsrs": "4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.28",
    "eslint-plugin-no-unsanitized": "^4.1.0",
    "eslint-plugin-security": "^3.0.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run",
      "eslint --fix"
    ],
    "*.py": [
      "node scripts/security-bandit.mjs"
    ],
    "{package.json,package-lock.json}": [
      "node scripts/security-lockfile.mjs"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.5"
  }
}
