{
  "name": "nuniversity-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs && node scripts/verify-css.mjs && node scripts/verify-csp.mjs",
    "start": "npx serve out -l 3000",
    "lint": "next lint",
    "prebuild": "node scripts/publish-media.mjs && node scripts/generate-search-index.mjs && node scripts/build-question-index.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:artifact": "vitest run --config vitest.artifact.config.ts",
    "test:e2e": "bash scripts/with-playwright-libs.sh playwright test",
    "test:e2e:integration": "bash scripts/with-playwright-libs.sh playwright test tests/e2e/integration",
    "test:e2e:journeys": "bash scripts/with-playwright-libs.sh playwright test tests/e2e/journeys",
    "test:all": "npm run build && npm run test:artifact && npm run test:e2e",
    "lint:content": "node scripts/lint-prose.mjs",
    "check:prose": "node scripts/normalise-prose.mjs",
    "fix:prose": "node scripts/normalise-prose.mjs --write",
    "icons": "node scripts/make-favicons.mjs",
    "security:bandit": "node scripts/security-bandit.mjs",
    "report:media": "node scripts/report-media-coverage.mjs",
    "report:coverage": "node scripts/report-content-coverage.mjs",
    "validate:courses": "node scripts/validate-courses.mjs",
    "backfill:skills": "node scripts/add-lesson-skills.mjs",
    "convert:questions": "node scripts/convert-prose-questions.mjs",
    "export:quizzes": "node scripts/export-quiz-bank.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formspree/react": "^3.0.0",
    "@tailwindcss/typography": "^0.5.10",
    "3dmol": "^2.5.5",
    "autoprefixer": "^10.4.16",
    "framer-motion": "^12.23.12",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.300.0",
    "mermaid": "^11.12.0",
    "next": "^14.2.33",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.3.0",
    "ts-fsrs": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.11",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run",
      "eslint --fix"
    ],
    "*.py": [
      "node scripts/security-bandit.mjs"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  }
}
