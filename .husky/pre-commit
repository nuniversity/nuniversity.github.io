# Husky pre-commit hook.
#
# 1. Secret scan: pinned, checksum-verified gitleaks against the staged diff.
# 2. lint-staged: vitest related + eslint (incl. security rules) for staged
#    TS/TSX, Bandit for Python, and signature/audit checks for dependency
#    changes (package.json / package-lock.json).
# 3. Integration gates (artifact tests + Chromium E2E) against the build in
#    out/. They run only when a build exists, so content-only commits without
#    a build are not blocked.
#
# The browser suite lives here (not in GitHub Actions) while it stabilises;
# the workflow keeps a commented copy of those steps for later.
#
# Bypass once:  SKIP_GITLEAKS=1 / SKIP_BANDIT=1 / SKIP_SECURITY_LOCKFILE=1 /
#               SKIP_INTEGRATION=1 git commit ...
# Bypass all:   git commit --no-verify
node scripts/security-gitleaks.mjs || exit 1
npx lint-staged

if [ "$SKIP_INTEGRATION" = "1" ]; then
  echo "pre-commit: SKIP_INTEGRATION=1 — integration tests skipped"
elif [ ! -f out/index.html ]; then
  echo "pre-commit: no build found in out/ — integration tests skipped"
  echo "pre-commit: run 'npm run build' once to enable them on every commit"
else
  echo "pre-commit: running artifact integration tests (npm run test:artifact)"
  npm run test:artifact || exit 1
  echo "pre-commit: running browser E2E tests (npm run test:e2e)"
  npm run test:e2e || exit 1
fi
